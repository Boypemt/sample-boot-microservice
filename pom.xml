<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.5.0</version>
        <relativePath/>
    </parent>

    <groupId>th.mfu</groupId>
    <artifactId>library-microservice</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!--
        packaging=pom: this project builds no jar of its own. It ties the three
        modules together and holds the settings they share.

        Run Maven from THIS folder.
    -->
    <packaging>pom</packaging>
    <name>library-microservice</name>

    <modules>
        <module>naming-server</module>
        <module>library-book-service</module>
        <module>library-transaction-service</module>
    </modules>

    <properties>
        <java.version>11</java.version>
        <!--
            Spring Cloud 2020.0.3 is the release train that goes with Spring Boot
            2.5. Change one and you must change the other.
        -->
        <spring-cloud.version>2020.0.3</spring-cloud.version>
        <!-- Same version as the 3-tier sample, so the generated code looks the same. -->
        <mapstruct.version>1.5.5.Final</mapstruct.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    MapStruct writes the mapper implementations while the code
                    compiles, so it is an annotation processor and not an
                    ordinary dependency. Copied from the 3-tier sample on
                    purpose: the students met it there, and it should not look
                    new here.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <compilerArg>-Amapstruct.defaultComponentModel=spring</compilerArg>
                        </compilerArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
